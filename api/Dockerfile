FROM node:20-bookworm-slim

WORKDIR /app

# OpenSSL for Prisma
RUN apt-get update && apt-get install -y openssl ca-certificates libssl-dev && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install

COPY prisma ./prisma
RUN npx prisma generate

COPY . .
EXPOSE 3070
CMD ["npm", "run", "dev"]
